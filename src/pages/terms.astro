---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Terms of Service - KharchaTracker" showNav={false}>
  <a href="/" class="text-sm mb-4 inline-block no-underline" style="color: #6366f1;">&larr; Back to Home</a>

  <h1 class="text-2xl font-bold mb-4" style="color: var(--color-text);">Terms of Service</h1>
  <p class="text-sm mb-4" style="color: var(--color-text-muted);">Last updated: October 2026</p>

  <div class="card mb-4">
    <div class="space-y-4 text-sm" style="color: var(--color-text);">
      <h2 class="text-lg font-semibold">Acceptance of Terms</h2>
      <p>By accessing and using KharchaTracker, you agree to these Terms. If you do not agree, please do not use the application.</p>

      <h2 class="text-lg font-semibold">Service Description</h2>
      <p>KharchaTracker is a free, browser-based expense tracking tool. All data is stored locally on your device.</p>

      <h2 class="text-lg font-semibold">No Financial Advice</h2>
      <p><strong>KharchaTracker is not a financial advisor.</strong> Insights and suggestions are informational only. Consult a qualified financial advisor for important decisions.</p>

      <h2 class="text-lg font-semibold">User Responsibilities</h2>
      <ul class="list-disc pl-5 space-y-1">
        <li>You are responsible for data accuracy</li>
        <li>Back up your data regularly (Settings > Export)</li>
        <li>Do not use the service for illegal purposes</li>
      </ul>

      <h2 class="text-lg font-semibold">Disclaimer</h2>
      <p>The service is provided "as is" without warranties. We are not liable for data loss or decisions made based on app information.</p>

      <h2 class="text-lg font-semibold">Contact</h2>
      <p>Questions? Email: <a href="mailto:hello@kharchatracker.com" style="color: #6366f1;">hello@kharchatracker.com</a></p>
    </div>
  </div>
</Layout>
