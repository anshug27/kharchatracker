---
import Layout from '../layouts/Layout.astro';
import AdUnit from '../components/AdUnit.astro';
---
<Layout title="Transaction History - KharchaTracker" activeNav="home">

  <!-- Monthly Totals -->
  <div class="grid grid-cols-3 gap-3 mb-4">
    <div class="card text-center" style="padding: 0.75rem;">
      <p class="text-xs" style="color: var(--color-text-muted);">Income</p>
      <p id="total-income" class="text-lg font-bold text-emerald-500">₹0</p>
    </div>
    <div class="card text-center" style="padding: 0.75rem;">
      <p class="text-xs" style="color: var(--color-text-muted);">Expenses</p>
      <p id="total-expense" class="text-lg font-bold text-red-500">₹0</p>
    </div>
    <div class="card text-center" style="padding: 0.75rem;">
      <p class="text-xs" style="color: var(--color-text-muted);">Savings</p>
      <p id="total-savings" class="text-lg font-bold text-indigo-500">₹0</p>
    </div>
  </div>

  <!-- Month/Year Filter Tabs -->
  <div class="flex gap-2 mb-4 overflow-x-auto pb-2 -mx-1 px-1 scrollbar-hide">
    <button id="prev-month-btn" class="btn-secondary text-sm flex-shrink-0" style="padding: 0.375rem 0.75rem;">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <div id="month-label" class="flex-1 text-center font-semibold text-sm py-1.5">December 2024</div>
    <button id="next-month-btn" class="btn-secondary text-sm flex-shrink-0" style="padding: 0.375rem 0.75rem;">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>

  <!-- Search Bar -->
  <div class="relative mb-4">
    <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input id="search-input" type="text" placeholder="Search by description or category..." class="input-field text-sm" style="padding-left: 2.5rem;" />
  </div>

  <!-- Filter Chips -->
  <div class="flex gap-2 mb-3">
    <button class="filter-chip badge bg-indigo-500 text-white cursor-pointer transition-all" data-filter="all">All</button>
    <button class="filter-chip badge border cursor-pointer transition-all" style="background: var(--color-surface-alt); color: var(--color-text); border-color: var(--color-border);" data-filter="expense">Expense</button>
    <button class="filter-chip badge border cursor-pointer transition-all" style="background: var(--color-surface-alt); color: var(--color-text); border-color: var(--color-border);" data-filter="income">Income</button>
  </div>

  <!-- Sort -->
  <div class="flex justify-end mb-4">
    <select id="sort-select" class="text-xs px-3 py-1.5 rounded-lg border" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);">
      <option value="latest">Latest first</option>
      <option value="oldest">Oldest first</option>
      <option value="highest">Highest amount</option>
    </select>
  </div>

  <AdUnit />

  <!-- Transaction List -->
  <div id="transaction-list" class="space-y-4 mb-4"></div>

  <!-- Empty State -->
  <div id="empty-state" class="hidden card text-center py-10">
    <p class="text-4xl mb-3">📜</p>
    <h3 class="font-semibold text-lg mb-1">No Transactions Found</h3>
    <p class="text-sm mb-4" style="color: var(--color-text-muted);">Start tracking your expenses and income to see your history here.</p>
    <a href="/add" class="btn-primary inline-block text-sm">Add Transaction</a>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/50 px-4 pb-4">
    <div class="card max-w-md w-full max-h-[80vh] overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-lg">Edit Transaction</h3>
        <button id="close-edit-modal" class="p-1 rounded-lg" onmouseover="this.style.background='var(--color-surface-alt)'" onmouseout="this.style.background=''">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <input id="edit-id" type="hidden" />
      <div class="space-y-3">
        <div>
          <label class="text-xs mb-1 block" style="color: var(--color-text-muted);">Amount</label>
          <input id="edit-amount" type="number" inputmode="decimal" class="input-field" min="0" />
        </div>
        <div>
          <label class="text-xs mb-1 block" style="color: var(--color-text-muted);">Description</label>
          <input id="edit-description" type="text" class="input-field" maxlength="100" />
        </div>
        <div>
          <label class="text-xs mb-1 block" style="color: var(--color-text-muted);">Category</label>
          <select id="edit-category" class="input-field text-sm"></select>
        </div>
        <div>
          <label class="text-xs mb-1 block" style="color: var(--color-text-muted);">Date</label>
          <input id="edit-date" type="date" class="input-field" />
        </div>
        <div>
          <label class="text-xs mb-1 block" style="color: var(--color-text-muted);">Type</label>
          <select id="edit-type" class="input-field text-sm">
            <option value="expense">Expense</option>
            <option value="income">Income</option>
          </select>
        </div>
        <button id="save-edit-btn" class="btn-primary w-full font-semibold" style="padding-top: 0.75rem; padding-bottom: 0.75rem;">Save Changes</button>
      </div>
    </div>
  </div>

  <AdUnit />

</Layout>

<script>
  const CATEGORY_ICONS: Record<string, string> = {
    'Food & Dining': '🍔', 'Transport': '🚗', 'Shopping': '🛍️',
    'Bills & Utilities': '💡', 'Entertainment': '🎬', 'Health': '🏥',
    'Education': '📚', 'Rent & Housing': '🏠', 'Subscriptions': '📱',
    'Personal Care': '💆', 'Investments': '📈', 'Other': '📌',
    'Salary': '💼', 'Freelance': '💻', 'Business': '🏪',
    'Investment Returns': '📈', 'Rental Income': '🏠', 'Gift': '🎁',
    'Refund': '💰',
  };

  interface Expense {
    id: string;
    amount: number;
    category: string;
    description: string;
    date: string;
    type: 'expense' | 'income';
    isRecurring?: boolean;
    recurringFrequency?: string;
    tags?: string[];
    paymentMethod?: string;
    createdAt: string;
  }

  let currentYear: number;
  let currentMonth: number;
  let currentFilter = 'all';
  let currentSort = 'latest';
  let searchQuery = '';

  function formatINR(amount: number): string {
    return '₹' + amount.toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getExpenses(): Expense[] {
    try {
      return JSON.parse(localStorage.getItem('kt_expenses') || '[]');
    } catch {
      return [];
    }
  }

  function getDateLabel(dateStr: string): string {
    const d = new Date(dateStr);
    const today = new Date();
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);

    if (d.toDateString() === today.toDateString()) return 'Today';
    if (d.toDateString() === yesterday.toDateString()) return 'Yesterday';
    return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: d.getFullYear() !== today.getFullYear() ? 'numeric' : undefined });
  }

  function showToast(message: string, type: 'success' | 'error') {
    const toast = document.createElement('div');
    toast.className = `toast ${type === 'success' ? 'bg-emerald-500' : 'bg-red-500'}`;
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
  }

  function init() {
    const now = new Date();
    currentYear = now.getFullYear();
    currentMonth = now.getMonth();

    // Month navigation
    document.getElementById('prev-month-btn')!.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) { currentMonth = 11; currentYear--; }
      renderAll();
    });
    document.getElementById('next-month-btn')!.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) { currentMonth = 0; currentYear++; }
      renderAll();
    });

    // Search
    document.getElementById('search-input')!.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      renderTransactions();
    });

    // Filter chips
    document.querySelectorAll('.filter-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        currentFilter = (chip as HTMLElement).dataset.filter || 'all';
        document.querySelectorAll('.filter-chip').forEach(c => {
          c.className = 'filter-chip badge border cursor-pointer transition-all';
          (c as HTMLElement).style.cssText = 'background: var(--color-surface-alt); color: var(--color-text); border-color: var(--color-border);';
        });
        chip.className = 'filter-chip badge bg-indigo-500 text-white cursor-pointer transition-all';
        (chip as HTMLElement).style.cssText = '';
        renderTransactions();
      });
    });

    // Sort
    document.getElementById('sort-select')!.addEventListener('change', (e) => {
      currentSort = (e.target as HTMLSelectElement).value;
      renderTransactions();
    });

    // Edit modal close
    const editModal = document.getElementById('edit-modal')!;
    document.getElementById('close-edit-modal')!.addEventListener('click', () => {
      editModal.classList.add('hidden');
    });
    editModal.addEventListener('click', (e) => {
      if (e.target === editModal) editModal.classList.add('hidden');
    });

    // Save edit
    document.getElementById('save-edit-btn')!.addEventListener('click', saveEdit);

    // Populate edit category dropdown
    populateEditCategories();

    renderAll();
  }

  function populateEditCategories() {
    const select = document.getElementById('edit-category') as HTMLSelectElement;
    const allCats = [
      'Food & Dining', 'Transport', 'Shopping', 'Bills & Utilities', 'Entertainment',
      'Health', 'Education', 'Rent & Housing', 'Subscriptions', 'Personal Care',
      'Investments', 'Other', 'Salary', 'Freelance', 'Business',
      'Investment Returns', 'Rental Income', 'Gift', 'Refund',
    ];
    try {
      const settings = JSON.parse(localStorage.getItem('kt_settings') || '{}');
      if (settings.categories) {
        settings.categories.forEach((c: { name: string }) => {
          if (!allCats.includes(c.name)) allCats.push(c.name);
        });
      }
    } catch {}
    select.innerHTML = allCats.map(c => `<option value="${c}">${c}</option>`).join('');
  }

  function renderAll() {
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    document.getElementById('month-label')!.textContent = `${monthNames[currentMonth]} ${currentYear}`;
    updateTotals();
    renderTransactions();
  }

  function updateTotals() {
    const expenses = getExpenses();
    const monthly = expenses.filter(e => {
      const d = new Date(e.date);
      return d.getMonth() === currentMonth && d.getFullYear() === currentYear;
    });

    const incomeTotal = monthly.filter(e => e.type === 'income').reduce((s, e) => s + e.amount, 0);
    const expenseTotal = monthly.filter(e => e.type === 'expense').reduce((s, e) => s + e.amount, 0);
    const savings = incomeTotal - expenseTotal;

    document.getElementById('total-income')!.textContent = formatINR(incomeTotal);
    document.getElementById('total-expense')!.textContent = formatINR(expenseTotal);

    const savingsEl = document.getElementById('total-savings')!;
    savingsEl.textContent = formatINR(Math.abs(savings));
    savingsEl.className = `text-lg font-bold ${savings >= 0 ? 'text-indigo-500' : 'text-red-500'}`;
    if (savings < 0) savingsEl.textContent = '-' + savingsEl.textContent;
  }

  function renderTransactions() {
    const expenses = getExpenses();
    const listEl = document.getElementById('transaction-list')!;
    const emptyEl = document.getElementById('empty-state')!;

    // Filter by month
    let filtered = expenses.filter(e => {
      const d = new Date(e.date);
      return d.getMonth() === currentMonth && d.getFullYear() === currentYear;
    });

    // Filter by type
    if (currentFilter !== 'all') {
      filtered = filtered.filter(e => e.type === currentFilter);
    }

    // Search
    if (searchQuery) {
      filtered = filtered.filter(e =>
        (e.description && e.description.toLowerCase().includes(searchQuery)) ||
        e.category.toLowerCase().includes(searchQuery)
      );
    }

    // Sort
    if (currentSort === 'latest') {
      filtered.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    } else if (currentSort === 'oldest') {
      filtered.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
    } else if (currentSort === 'highest') {
      filtered.sort((a, b) => b.amount - a.amount);
    }

    if (filtered.length === 0) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');

    // Group by date
    const groups: Record<string, Expense[]> = {};
    filtered.forEach(e => {
      const label = getDateLabel(e.date);
      if (!groups[label]) groups[label] = [];
      groups[label].push(e);
    });

    listEl.innerHTML = Object.entries(groups).map(([dateLabel, items]) => `
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide mb-2 px-1" style="color: var(--color-text-muted);">${dateLabel}</p>
        <div class="space-y-2">
          ${items.map(e => {
            const icon = CATEGORY_ICONS[e.category] || '📌';
            const isIncome = e.type === 'income';
            const d = new Date(e.date);
            const timeStr = d.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
            return `
              <div class="card flex items-center gap-3 group" style="padding: 0.75rem;" data-id="${e.id}">
                <span class="text-2xl flex-shrink-0">${icon}</span>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-sm truncate">${e.description || e.category}</p>
                  <p class="text-xs" style="color: var(--color-text-muted);">${e.category}${e.paymentMethod ? ' · ' + e.paymentMethod : ''}</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="font-semibold text-sm ${isIncome ? 'text-emerald-500' : 'text-red-500'}">
                    ${isIncome ? '+' : '-'}${formatINR(e.amount)}
                  </p>
                  <p class="text-[10px]" style="color: var(--color-text-muted);">${timeStr}</p>
                </div>
                <div class="flex flex-col gap-1 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
                  <button class="edit-btn p-1 rounded" onmouseover="this.style.background='var(--color-surface-alt)'" onmouseout="this.style.background=''" data-id="${e.id}" aria-label="Edit">
                    <svg class="w-4 h-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </button>
                  <button class="delete-btn p-1 rounded hover:bg-red-50 dark:hover:bg-red-950" data-id="${e.id}" aria-label="Delete">
                    <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      </div>
    `).join('');

    // Attach edit handlers
    listEl.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        openEditModal((btn as HTMLElement).dataset.id!);
      });
    });

    // Attach delete handlers
    listEl.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteTransaction((btn as HTMLElement).dataset.id!);
      });
    });

    // Swipe to delete on mobile
    listEl.querySelectorAll('.card[data-id]').forEach(card => {
      let startX = 0;
      let currentX = 0;
      const el = card as HTMLElement;

      el.addEventListener('touchstart', (e) => {
        startX = (e as TouchEvent).touches[0].clientX;
      }, { passive: true });

      el.addEventListener('touchmove', (e) => {
        currentX = (e as TouchEvent).touches[0].clientX;
        const diff = startX - currentX;
        if (diff > 0 && diff < 120) {
          el.style.transform = `translateX(-${diff}px)`;
          el.style.opacity = String(1 - diff / 200);
        }
      }, { passive: true });

      el.addEventListener('touchend', () => {
        const diff = startX - currentX;
        if (diff > 80) {
          el.classList.add('swipe-left');
          setTimeout(() => {
            deleteTransaction(el.dataset.id!);
          }, 300);
        } else {
          el.style.transform = '';
          el.style.opacity = '';
        }
      });
    });
  }

  function openEditModal(id: string) {
    const expenses = getExpenses();
    const expense = expenses.find(e => e.id === id);
    if (!expense) return;

    (document.getElementById('edit-id') as HTMLInputElement).value = id;
    (document.getElementById('edit-amount') as HTMLInputElement).value = String(expense.amount);
    (document.getElementById('edit-description') as HTMLInputElement).value = expense.description || '';
    (document.getElementById('edit-category') as HTMLSelectElement).value = expense.category;
    (document.getElementById('edit-date') as HTMLInputElement).value = expense.date.split('T')[0];
    (document.getElementById('edit-type') as HTMLSelectElement).value = expense.type;

    document.getElementById('edit-modal')!.classList.remove('hidden');
  }

  function saveEdit() {
    const id = (document.getElementById('edit-id') as HTMLInputElement).value;
    const amount = parseFloat((document.getElementById('edit-amount') as HTMLInputElement).value);
    const description = (document.getElementById('edit-description') as HTMLInputElement).value.trim();
    const category = (document.getElementById('edit-category') as HTMLSelectElement).value;
    const date = (document.getElementById('edit-date') as HTMLInputElement).value;
    const type = (document.getElementById('edit-type') as HTMLSelectElement).value as 'expense' | 'income';

    if (!amount || amount <= 0) {
      showToast('Please enter a valid amount', 'error');
      return;
    }

    const expenses = getExpenses();
    const idx = expenses.findIndex(e => e.id === id);
    if (idx !== -1) {
      expenses[idx] = {
        ...expenses[idx],
        amount,
        description,
        category,
        date: new Date(date).toISOString(),
        type,
      };
      localStorage.setItem('kt_expenses', JSON.stringify(expenses));
      showToast('Transaction updated!', 'success');
      document.getElementById('edit-modal')!.classList.add('hidden');
      renderAll();
    }
  }

  function deleteTransaction(id: string) {
    if (!confirm('Delete this transaction?')) return;
    const expenses = getExpenses().filter(e => e.id !== id);
    localStorage.setItem('kt_expenses', JSON.stringify(expenses));
    showToast('Transaction deleted', 'success');
    renderAll();
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
</script>
